{
  "name": "ongoing-commiter",
  "version": "1.0.0",
  "description": "Commit Monitor demo with Docker and Jenkins pipeline",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "committer": "node updater.js",
    "lint": "npx eslint .",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.js",
    "test:integration": "node --test tests/integration/*.js",
    "test:e2e": "node --test tests/e2e/*.js",
    "build": "echo Building app...",
    "health-check": "node scripts/health-check.js",
    "report": "node scripts/generate-report.js"
  },
